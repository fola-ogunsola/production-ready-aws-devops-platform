NODE_ENV=development
HOST=0.0.0.0
PORT=3000
HOST_PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
TRUST_PROXY_HOPS=0
SHUTDOWN_TIMEOUT_MS=10000
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=task_api
DATABASE_USER=task_api
DATABASE_PASSWORD=REPLACE_WITH_A_RANDOM_LOCAL_PASSWORD_OF_16_OR_MORE_CHARACTERS
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_LOCAL_PASSWORD
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=3000
DATABASE_QUERY_TIMEOUT_MS=5000
JWT_SECRET_BASE64=REPLACE_WITH_OUTPUT_OF_openssl_rand_-base64_32
