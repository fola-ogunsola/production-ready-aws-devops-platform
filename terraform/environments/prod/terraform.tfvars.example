project_name        = "production-ready-aws-devops-platform"
environment         = "prod"
aws_region          = "eu-west-1"
aws_profile         = null
expected_account_id = "" # Replace with the intended 12-digit account ID before planning.

additional_tags = {
  CostCentre = "production"
}

vpc_cidr           = "10.30.0.0/16"
availability_zones = ["eu-west-1a", "eu-west-1b", "eu-west-1c"]
public_subnet_cidrs = [
  "10.30.0.0/24",
  "10.30.1.0/24",
  "10.30.2.0/24",
]
private_subnet_cidrs = [
  "10.30.10.0/24",
  "10.30.11.0/24",
  "10.30.12.0/24",
]
enable_nat_gateway         = true
single_nat_gateway         = false
enable_s3_gateway_endpoint = true
application_port                 = 3000
database_port                    = 5432
alb_ingress_cidrs                = ["0.0.0.0/0"]
enable_alb_http_ingress          = false
ecs_https_egress_cidrs           = ["0.0.0.0/0"]
alb_scheme                       = "internet-facing"
enable_alb_deletion_protection   = true
enable_alb_access_logs           = false
alb_access_logs_bucket_id        = null
alb_acm_certificate_arn          = null
enable_alb_https_listener        = false
enable_alb_http_listener         = false
alb_waf_web_acl_arn               = null
ecr_repository_name             = "production-ready-aws-devops-platform-prod-api"
ecr_scan_on_push                = true
ecr_force_delete                = false
ecr_lifecycle_policy_enabled    = true
ecr_production_image_retention  = 30
ecr_rollback_image_retention    = 10
ecr_sha_image_retention         = 50
enable_ecs_service              = false
ecs_image_reference             = null
ecs_task_cpu                    = 512
ecs_task_memory                 = 1024
ecs_desired_count               = 2
ecs_health_check_grace_period   = 60
ecs_enable_container_insights   = true
ecs_log_retention_days          = 365
ecs_database_host               = null
ecs_database_name               = null
ecs_database_user               = null
ecs_secret_environment_variables = {}
ecs_kms_key_arns                = {}
ecs_jwt_issuer                  = null
ecs_jwt_audience                = null
