project_name        = "production-ready-aws-devops-platform"
environment         = "dev"
aws_region          = "eu-west-1"
aws_profile         = null
expected_account_id = "" # Replace with the intended 12-digit account ID before planning.

additional_tags = {
  CostCentre = "development"
}

vpc_cidr           = "10.20.0.0/16"
availability_zones = ["eu-west-1a", "eu-west-1b"]
public_subnet_cidrs = [
  "10.20.0.0/24",
  "10.20.1.0/24",
]
private_subnet_cidrs = [
  "10.20.10.0/24",
  "10.20.11.0/24",
]
enable_nat_gateway         = true
single_nat_gateway         = true
enable_s3_gateway_endpoint = true
